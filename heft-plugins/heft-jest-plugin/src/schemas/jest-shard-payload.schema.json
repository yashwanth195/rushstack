{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Jest shard payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "passWithNoTests",
    "coverage",
    "testFiles",
    "passed",
    "failed",
    "skipped",
    "todo",
    "failedSuites",
    "runtimeErrorSuites",
    "snapshotFailure",
    "success",
    "failureReasons"
  ],
  "definitions": {
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "message": { "type": ["string", "null"], "minLength": 1 }
  },
  "properties": {
    "version": { "enum": [2, 3] },
    "producerId": { "type": "string", "minLength": 1 },
    "passWithNoTests": { "type": "boolean" },
    "coverage": { "type": "object" },
    "passed": { "$ref": "#/definitions/count" },
    "failed": { "$ref": "#/definitions/count" },
    "skipped": { "$ref": "#/definitions/count" },
    "todo": { "$ref": "#/definitions/count" },
    "failedSuites": { "$ref": "#/definitions/count" },
    "runtimeErrorSuites": { "$ref": "#/definitions/count" },
    "snapshotFailure": { "type": "boolean" },
    "success": { "type": "boolean" },
    "failureReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "failed-tests",
          "failed-suites",
          "suite-execution-errors",
          "snapshot-failure",
          "jest-unsuccessful"
        ]
      }
    },
    "testFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "passed",
          "failed",
          "skipped",
          "todo",
          "failureMessage",
          "executionError",
          "snapshotFailure",
          "failures"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "passed": { "$ref": "#/definitions/count" },
          "failed": { "$ref": "#/definitions/count" },
          "skipped": { "$ref": "#/definitions/count" },
          "todo": { "$ref": "#/definitions/count" },
          "failureMessage": { "$ref": "#/definitions/message" },
          "executionError": { "$ref": "#/definitions/message" },
          "snapshotFailure": { "type": "boolean" },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "fullName", "ancestorTitles", "status", "durationMs", "failureMessages"],
              "properties": {
                "title": { "type": "string" },
                "fullName": { "type": "string" },
                "ancestorTitles": { "type": "array", "items": { "type": "string" } },
                "status": { "enum": ["passed", "failed", "pending", "skipped", "disabled", "todo"] },
                "durationMs": { "type": ["number", "null"], "minimum": 0, "maximum": 9007199254740991 },
                "failureMessages": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["testName", "messages"],
              "properties": {
                "testName": { "type": "string", "minLength": 1 },
                "messages": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
